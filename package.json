{
  "name": "arrowbox2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "chk": "concurrently 'bun:chk:*'",
    "chk:lint": "eslint src/ --fix",
    "chk:test": "vitest run src/",
    "chk:types": "tsc",
    "clean": "rm -rf dist/",
    "deps": "bunx npm-check-updates --interactive --install always",
    "dev": "vite",
    "dpl": "bun chk && rm -rf dist/ && vite build && wrangler pages deploy dist/ --commit-dirty=true"
  },
  "dependencies": {
    "@kobalte/core": "^0.12.6",
    "@mermaid-js/parser": "0.1.0-rc.1",
    "@solid-primitives/destructure": "^0.1.17",
    "@solidjs/router": "^0.13.6",
    "d3-drag": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.1.7",
    "elkjs": "^0.9.3",
    "hotkeys-js": "^3.13.7",
    "immer": "^10.1.1",
    "marked": "^12.0.2",
    "mermaid": "^10.9.3",
    "rbush": "^3.0.1",
    "solid-js": "^1.9.3",
    "terracotta": "^1.0.6"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/dompurify": "^3.0.5",
    "@types/rbush": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.13.2",
    "fast-check": "^3.22.0",
    "happy-dom": "^14.12.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.4",
    "wrangler": "^3.83.0"
  }
}
