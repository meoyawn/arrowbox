    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "hotkeys-js": "^3.13.6",
    "immer": "^10.0.3",
    "rbush": "^3.0.1",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "solid-js": "^1.8.12",
    "tailwind-merge": "^2.2.1",
    "unified": "^11.0.4"
