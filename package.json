{
  "name": "arrowbox2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "chk": "concurrently 'bun:chk:*'",
    "chk:lint": "eslint src/ --fix",
    "chk:playwright": "bun playwright test",
    "chk:test": "bun test",
    "chk:types": "tsc",
    "clean": "rm -rf dist/",
    "deps": "bunx npm-check-updates --interactive --install always",
    "dev": "vite",
    "dpl": "bun chk && rm -rf dist/ && vite build && wrangler pages deploy dist/ --commit-dirty=true"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@mermaid-js/parser": "1.2.0",
    "@solid-primitives/destructure": "^0.2.3",
    "@solidjs/router": "^0.16.1",
    "d3-drag": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.11",
    "elkjs": "^0.11.1",
    "hotkeys-js": "^4.0.4",
    "immer": "^11.1.8",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "rbush": "^4.0.1",
    "solid-js": "^1.9.13",
    "terracotta": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/dompurify": "^3.2.0",
    "@types/rbush": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.14.5",
    "fast-check": "^4.8.0",
    "prettier": "^3.9.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.105.0"
  }
}
