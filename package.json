{
  "name": "arrowbox2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "chk": "concurrently bun:chk:*",
    "chk:lint": "eslint src/ --fix",
    "chk:test": "bun test",
    "chk:types": "tsc",
