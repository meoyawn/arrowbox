    "d3-zoom": "^3.0.0",
    "dompurify": "^3.0.9",
    "elkjs": "^0.9.2",
    "hotkeys-js": "^3.13.7",
    "immer": "^10.0.3",
    "marked": "^12.0.0",
    "mermaid": "^10.8.0",
    "rbush": "^3.0.1",
    "solid-js": "^1.8.15",
    "terracotta": "^1.0.5"
