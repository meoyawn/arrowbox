    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-solid": "^0.13.1",
    "fast-check": "^3.15.1",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
